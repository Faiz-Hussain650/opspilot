# Copy to .env and adjust:  cp .env.example .env
# This file is for running things on your Mac (scripts, evals, `uv run`).
# docker-compose overrides QDRANT_URL and OLLAMA_BASE_URL for the containers.

# ---------------------------------------------------------------- mode
# local = Ollama + Qdrant in Docker      cloud = Groq + Qdrant Cloud
OPSPILOT_MODE=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------- local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------- vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------------------------------------------------------------- cloud (Phase 3)
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: a separate (cheaper/faster) model for the evaluation judge
JUDGE_MODEL=

# Langfuse tracing (optional, free Hobby plan): https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------- tuning
CANDIDATE_K=20
TOP_K=5
RERANK_ENABLED=true
MAX_QUERY_REWRITES=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92

# ---------------------------------------------------------------- MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=opspilot-eval

# Grafana admin password (user: admin)
GRAFANA_PASSWORD=admin
