# Paste this (with your values) into Streamlit Community Cloud:
#   your app -> Settings -> Secrets
# Root-level keys are exposed to the app as environment variables,
# which is exactly how OpsPilot reads its settings.

OPSPILOT_MODE = "cloud"
UI_BACKEND = "direct"

GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "llama-3.3-70b-versatile"

QDRANT_URL = "https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY = "..."

# The knowledge base is already in Qdrant Cloud (make ingest-cloud),
# so don't re-index on every cold start.
AUTO_INGEST = "false"

# Optional tracing
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_SECRET_KEY = ""
