{
  "uid": "opspilot-main",
  "title": "OpsPilot - RAG service",
  "tags": [
    "opspilot",
    "rag",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
